# 비밀
.env

# 파이썬
.venv/
__pycache__/
*.pyc
*.egg-info/

# 캐시는 제외하고 결과는 남긴다. 결과 파일이 문서와 제출물의 근거다.
eval/results/pharmasignal_cache_*.json
eval/results/config_*.json
eval/results/config_*.yml

# 산출물
docs/*.pdf
.DS_Store

# 키가 들어간 백업
.env.*
!.env.example

# 강좌 원문을 옮긴 노트. 저작권 때문에 공개 저장소에 두지 않는다.
# 원본은 구글 드라이브에 보관하고 docs/COURSE-GUIDE.md 가 링크를 가리킨다.
docs/notes/dli-course/
assets/video/slides/*.html

# 개인 작업 환경과 도구 설정. 저장소에 올리지 않는다.
# 팀이 함께 지키는 규약은 docs/CONVENTIONS.md 에 있다.
.*/
!.github/
!.gitignore
# 맥은 core.ignorecase 가 true 라 대문자 패턴이 소문자 파일까지 잡는다.
# 앵커를 붙여 저장소 루트에만 적용한다. 붙이지 않으면 docs/ 아래 새 문서가 조용히 빠진다.
/[A-Z][A-Z]*.md
!README.md
*.local.md

# 배경음악 원본. macOS 기본 제공 음원이라 저장소에 두지 않는다.
# bgm_pick.sh 로 다시 앉힌다. 출처는 assets/video/bgm/출처.md
assets/video/bgm/

# 렌더 산출물. 다시 만들 수 있고 이력을 불린다. 공유는 드라이브로 한다.
assets/video/*.mp4
!assets/video/slides/
assets/video/_*
assets/video/[stf]_*.png
assets/video/[st]_*.mp3

# 저장소에 올리지 않는 로컬 작업물을 한 곳에 모은다. 폴더째 제외한다.
# 안에 든 것: 팀 메시지(실명), 렌더 산출물, 강좌 원문 노트.
# git clean -fdx 는 이 폴더를 지우므로 그 명령은 쓰지 않는다.
_local/
